# Optional. When set, the AI Copilot (/api/chat) calls Anthropic's Claude API
# with full expediente context. Without it, the Copilot falls back to a
# deterministic rule-based responder (lib/ai/mock-chat.ts) so the product
# works end-to-end with zero configuration.
ANTHROPIC_API_KEY=

# Secret used to sign the session cookie (lib/auth/session.ts). Set this to a
# long random value in any real deployment — falls back to a fixed dev-only
# secret otherwise, which is fine for local prototyping but not for prod.
SESSION_SECRET=
